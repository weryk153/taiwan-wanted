---
import Base from "../layouts/Base.astro";
import { loadData, SOURCE_LABEL } from "../lib/data";
import { rankRewards, formatReward } from "../lib/rewards";
const { records, meta } = loadData();
const ranked = rankRewards(records);
const unranked = records.length - ranked.length;
const stale = meta.sources.cib.stale || meta.sources.mjib.stale;
---
<Base title="懸賞獎金排行" description="依官方個案公告明載的新臺幣檢舉獎金，由高至低排列，保留獎金上限及核發條件。" noindex>
  <a class="back" href="/">← 回通緝公告欄</a>
  <section class="reward-heading">
    <p class="eyebrow">OFFICIAL REWARD AMOUNTS</p>
    <h1>懸賞獎金排行</h1>
    <p>依官方個案公告明載的新臺幣獎金，由高至低排列。標有「最高」的是獎金上限，實際核發依官方條件審核。</p>
    <p class="coverage">資料擷取日 <time datetime={meta.fetchedAt}>{meta.fetchedAt.slice(0, 10)}</time> · {records.length} 筆公告中，<strong>{ranked.length} 筆</strong>可依金額排序，{unranked} 筆未列入。</p>
    {stale && <p class="warn">部分來源同步失敗，目前使用上一版公告；獎金請再次向官方確認。</p>}
  </section>
  {ranked.length > 0 ? <ol class="reward-list" aria-label="官方公告獎金由高至低排行">
    {ranked.map(({ record, reward, rank }) => <li value={rank}>
      <div class="rank" aria-label={`第 ${rank} 名`}>{String(rank).padStart(2, "0")}</div>
      <div class="identity">
        <p class="source">{SOURCE_LABEL[record.source]}公告 · {record.category}</p>
        <h2><a href={`/p/${record.id}/`}>{record.name}</a></h2>
        <p>{record.wantedUnit}</p>
      </div>
      <div class="amount"><span>{reward.maximum ? "最高檢舉獎金" : "公告檢舉獎金"}</span><strong><small>NT$</small> {formatReward(reward.amount)}</strong></div>
      <div class="conditions"><p>{reward.text}。</p><a href={record.sourceUrl} target="_blank" rel="noopener noreferrer">查看官方金額與條件 ↗</a><a href={`/p/${record.id}/`}>案件資料 →</a></div>
    </li>)}
  </ol> : <p class="warn">目前沒有可依明確金額排序的個案公告。可先查看<a href="/">全部名單</a>及各筆官方公告。</p>}
  <section class="explanation">
    <h2>哪些公告會列入？</h2>
    <p>只列入個案公告中可辨識的單一新臺幣獎金。同額並列同一名次；同名或跨機關公告以各筆公告分列。排行隨每日公告同步更新。</p>
    <p>其餘 {unranked} 筆未提供可排序的個案金額，或文字格式尚無法確認。未列入不代表沒有檢舉獎金；犯罪所得、涉案金額及通用獎勵上限均不當作個人懸賞。</p>
    <p><a href="https://www.mjib.gov.tw/EditPage/?PageID=b04ca88f-4ecd-48ae-9828-f669dc836d35" target="_blank" rel="noopener noreferrer">調查局追緝要犯與獎勵規定 ↗</a> · <a href="/">查看全部 {records.length} 筆公告 →</a></p>
    <p>如有線索，請聯絡官方公告所列機關；請勿自行接觸或追捕。</p>
  </section>
</Base>
<style>
  .reward-heading { padding: 18px 0 26px; border-bottom: 4px double var(--ink); }
  .eyebrow, .source, .coverage { color: var(--ink-2); font-size: 12px; }
  .eyebrow { letter-spacing: .12em; }
  h1 { font: 900 clamp(28px, 4vw, 44px)/1.4 var(--serif); margin: 8px 0 16px; }
  .reward-heading > p { max-width: 70em; }
  .reward-list { list-style: none; padding: 0; margin: 24px 0; }
  .reward-list li { display: grid; grid-template-columns: 70px 1fr auto; gap: 16px 24px; padding: 28px; margin: 16px 0; background: var(--paper); border: 1px solid var(--ink); }
  .rank { font: 700 44px/1.3 Georgia, serif; color: var(--red); }
  .identity h2 { font: 900 27px/1.4 var(--serif); margin: 6px 0; }
  .identity p { margin: 0; font-size: 13px; }
  .amount { align-self: center; text-align: right; }
  .amount > span { display: block; font-size: 12px; color: var(--ink-2); }
  .amount strong { display: block; font: 700 clamp(26px, 4vw, 42px)/1.5 Georgia, serif; color: var(--red); font-variant-numeric: tabular-nums; }
  .amount small { font: 500 13px var(--sans); }
  .conditions { grid-column: 2 / -1; border-top: 1px solid var(--rule); padding-top: 12px; font-size: 13px; }
  .conditions p { margin: 0 0 10px; }
  .conditions a { display: inline-block; margin: 0 20px 4px 0; }
  .explanation { margin: 32px 0 48px; max-width: 75ch; font-size: 14px; }
  .explanation h2 { font: 900 22px/1.5 var(--serif); }
  @media (max-width: 600px) {
    .reward-list li { grid-template-columns: 42px minmax(0, 1fr); padding: 20px 16px; gap: 12px; }
    .rank { font-size: 30px; }
    .amount { grid-column: 2; text-align: left; }
    .conditions { grid-column: 1 / -1; }
  }
</style>
